@using System.Text.Json.Nodes

@if (Visible)
{
    <div class="widget-config-backdrop" @onclick="Close"></div>
    <div class="widget-config-panel">
        <div class="widget-config-panel-header">
            <h5 class="mb-0">Configure</h5>
            <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
        </div>
        <div class="widget-config-panel-body">
            @if (_editConfig is not null)
            {
                @foreach (var entry in Schema)
                {
                    var propName = entry.Key;
                    var schema = entry.Value;

                    @if (schema.FieldType == ConfigFieldType.Hidden)
                    {
                        continue;
                    }

                    var label = !string.IsNullOrEmpty(schema.Label) ? schema.Label : FormatLabel(propName);
                    <div class="mb-3">
                        <label class="form-label">@label</label>
                        @if (schema.FieldType == ConfigFieldType.Select)
                        {
                            var strVal = GetString(propName);
                            <select class="form-select"
                                    value="@strVal"
                                    @onchange="@(e => UpdateProperty(propName, e.Value?.ToString() ?? ""))">
                                @foreach (var opt in schema.Options)
                                {
                                    <option value="@opt.Value" selected="@(strVal == opt.Value)">@opt.Label</option>
                                }
                            </select>
                        }
                        else if (schema.FieldType == ConfigFieldType.Textarea)
                        {
                            var strVal = GetString(propName);
                            <textarea class="form-control" rows="@(schema.Rows ?? 6)"
                                      @onchange="@(e => UpdateProperty(propName, e.Value?.ToString() ?? ""))">@strVal</textarea>
                        }
                        else if (schema.FieldType == ConfigFieldType.Number)
                        {
                            var intVal = GetInt(propName);
                            <input type="number" class="form-control"
                                   min="@(schema.Min)" max="@(schema.Max)"
                                   value="@intVal"
                                   @onchange="@(e => UpdateProperty(propName, int.TryParse(e.Value?.ToString(), out var v) ? v : 0))" />
                        }
                        else if (schema.FieldType == ConfigFieldType.Checkbox)
                        {
                            var boolVal = GetBool(propName);
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input"
                                       checked="@boolVal"
                                       @onchange="@(e => UpdateProperty(propName, e.Value is bool b && b))" />
                            </div>
                        }
                        else
                        {
                            var strVal = GetString(propName);
                            <input type="text" class="form-control"
                                   value="@strVal"
                                   @onchange="@(e => UpdateProperty(propName, e.Value?.ToString() ?? ""))" />
                        }
                    </div>
                }
            }
        </div>
        <div class="widget-config-panel-footer">
            <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="Save">Save</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public Dictionary<string, ConfigFieldSchema> Schema { get; set; } = new();
    [Parameter] public JsonObject Config { get; set; } = new();
    [Parameter] public EventCallback<JsonObject> ConfigChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private JsonObject? _editConfig;
    private bool _wasVisible;

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            _wasVisible = true;
            // Deep clone the config so edits don't affect the original until saved
            _editConfig = Config is not null
                ? (JsonObject)Config.DeepClone()
                : new JsonObject();
        }
        else if (!Visible)
        {
            _wasVisible = false;
        }
    }

    private string GetString(string name)
    {
        if (_editConfig is null || !_editConfig.TryGetPropertyValue(name, out var node) || node is null)
            return "";
        try { return node.GetValue<string>(); }
        catch { return node.ToString(); }
    }

    private int GetInt(string name)
    {
        if (_editConfig is null || !_editConfig.TryGetPropertyValue(name, out var node) || node is null)
            return 0;
        try { return node.GetValue<int>(); }
        catch { return int.TryParse(node.ToString(), out var v) ? v : 0; }
    }

    private bool GetBool(string name)
    {
        if (_editConfig is null || !_editConfig.TryGetPropertyValue(name, out var node) || node is null)
            return false;
        try { return node.GetValue<bool>(); }
        catch { return bool.TryParse(node.ToString(), out var v) && v; }
    }

    private void UpdateProperty(string name, object value)
    {
        if (_editConfig is null) return;
        _editConfig[name] = JsonValue.Create(value);
    }

    private async Task Save()
    {
        if (_editConfig is not null)
        {
            _wasVisible = false;
            var config = _editConfig;
            _editConfig = null;
            await ConfigChanged.InvokeAsync(config);
        }
    }

    private async Task Close()
    {
        _wasVisible = false;
        _editConfig = null;
        await OnClose.InvokeAsync();
    }

    private static string FormatLabel(string propertyName)
    {
        // Convert PascalCase/camelCase to "Title Case"
        var result = new System.Text.StringBuilder();
        for (int i = 0; i < propertyName.Length; i++)
        {
            var c = propertyName[i];
            if (i > 0 && char.IsUpper(c))
            {
                result.Append(' ');
            }
            result.Append(i == 0 ? char.ToUpper(c) : c);
        }
        return result.ToString();
    }
}
