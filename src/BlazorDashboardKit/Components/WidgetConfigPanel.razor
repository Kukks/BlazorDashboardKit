@using System.Text.Json.Nodes

@if (Visible)
{
    <div class="widget-config-backdrop" @onclick="Close"></div>
    <div class="widget-config-panel">
        <div class="widget-config-panel-header">
            <h5 class="mb-0">Configure</h5>
            <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
        </div>
        <div class="widget-config-panel-body">
            @if (ConfigComponentType is not null && _working is not null)
            {
                <DynamicComponent Type="ConfigComponentType" Parameters="_childParameters" />
            }
            else
            {
                <p class="text-muted mb-0">This widget has no configuration.</p>
            }
        </div>
        <div class="widget-config-panel-footer">
            <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
            @if (ConfigComponentType is not null)
            {
                <button type="button" class="btn btn-primary" @onclick="Save">Save</button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }

    /// <summary>The widget's config component type (WidgetDescriptor.ConfigComponentType).</summary>
    [Parameter] public Type? ConfigComponentType { get; set; }

    [Parameter] public JsonObject Config { get; set; } = new();
    [Parameter] public EventCallback<JsonObject> ConfigChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    // The panel owns Save/Cancel: the child edits this isolated working clone
    // and pushes updates into it; nothing reaches ConfigChanged until Save.
    private JsonObject? _working;
    private bool _wasVisible;

    private IDictionary<string, object> _childParameters => new Dictionary<string, object>
    {
        ["ConfigJson"] = _working!,
        ["ConfigJsonChanged"] = EventCallback.Factory.Create<JsonObject>(
            this, updated => _working = updated)
    };

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            _wasVisible = true;
            _working = Config is not null ? (JsonObject)Config.DeepClone() : new JsonObject();
        }
        else if (!Visible)
        {
            _wasVisible = false;
        }
    }

    private async Task Save()
    {
        if (_working is not null)
        {
            _wasVisible = false;
            var config = _working;
            _working = null;
            await ConfigChanged.InvokeAsync(config);
        }
    }

    private async Task Close()
    {
        _wasVisible = false;
        _working = null;
        await OnClose.InvokeAsync();
    }
}
