@if (_open)
{
    @* Pure-Blazor click-outside: a transparent full-viewport backdrop behind
       the menu. No Bootstrap JS, no document listeners, no JS interop. *@
    <div class="bdk-dropdown-backdrop" @onclick="Close"></div>
}
<div class="dropdown @(_open ? "show" : null)" @onkeydown="OnKeyDown">
    <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button"
            @onclick="Toggle" aria-expanded="@(_open ? "true" : "false")">
        Add Widget
    </button>
    <div class="dropdown-menu dropdown-menu-end @(_open ? "show" : null)" style="min-width: 260px; max-height: 400px; overflow-y: auto;">
        @foreach (var group in Available.GroupBy(d => d.Category).OrderBy(g => g.Key))
        {
            <div class="widget-picker-category">@group.Key</div>
            @foreach (var descriptor in group.OrderBy(d => d.Name))
            {
                <button class="dropdown-item small" @onclick="() => AddWidget(descriptor)">
                    @if (descriptor.IconCssClass is not null)
                    {
                        <span class="@descriptor.IconCssClass me-1"></span>
                    }
                    @descriptor.Name
                    @if (!string.IsNullOrEmpty(descriptor.Description))
                    {
                        <span class="d-block text-muted" style="font-size: 0.7rem;">@descriptor.Description</span>
                    }
                </button>
            }
        }
    </div>
</div>

@code {
    private bool _open;

    [Parameter] public IReadOnlyList<WidgetDescriptor> Available { get; set; } = Array.Empty<WidgetDescriptor>();
    [Parameter] public EventCallback<WidgetDescriptor> OnWidgetAdded { get; set; }

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _open = false;
    }

    private async Task AddWidget(WidgetDescriptor descriptor)
    {
        _open = false;
        await OnWidgetAdded.InvokeAsync(descriptor);
    }
}
