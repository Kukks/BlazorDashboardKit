<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.27" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.27" />
  </ItemGroup>

  <ItemGroup>
    <!-- DashboardService is internal (host-agnostic implementation detail; the only
         public dashboard surface is the DashboardHost component). The test project
         exercises it directly, as does bunit DI registration. -->
    <InternalsVisibleTo Include="BlazorDashboardKit.Tests" />
  </ItemGroup>

</Project>
