@inherits WidgetConfigComponent<MarkdownNoteWidget.NoteConfig>

<div class="mb-3">
    <label class="form-label">Title</label>
    <input class="form-control" value="@Model.Title" @onchange="OnTitle" />
</div>
<div class="mb-3">
    <label class="form-label">Body</label>
    <textarea class="form-control" rows="8" @onchange="OnBody">@Model.Body</textarea>
</div>

@code {
    private async Task OnTitle(ChangeEventArgs e)
    {
        Model.Title = e.Value?.ToString() ?? "";
        await NotifyChangedAsync();
    }

    private async Task OnBody(ChangeEventArgs e)
    {
        Model.Body = e.Value?.ToString() ?? "";
        await NotifyChangedAsync();
    }
}
